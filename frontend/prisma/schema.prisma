generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events              Event[]
  designs             Design[]
  exportLogs          ExportLog[]
  activityLogs        ActivityLog[]
  organizationMembers OrganizationMember[]
  paymentOrders       PaymentOrder[]
}

model Organization {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  plan      Plan                 @default(FREE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   OrganizationMember[]
  invites   OrgInvite[]
  events    Event[]
}

model OrgInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           OrgRole      @default(MEMBER)
  token          String       @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  emailSentAt    DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(MEMBER)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

model PaymentOrder {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id])
  plan              Plan
  amount            Int
  currency          String             @default("UZS")
  provider          PaymentProvider?
  status            PaymentOrderStatus @default(PENDING)
  providerRef       String?
  meta              Json?
  paidAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  paymeTransactions PaymeTransaction[]

  @@index([userId, status])
}

model PaymeTransaction {
  id          String       @id @default(cuid())
  orderId     String
  order       PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymeId     String       @unique
  state       Int          @default(1)
  createTime  BigInt
  performTime BigInt       @default(0)
  cancelTime  BigInt       @default(0)
  reason      Int?
  createdAt   DateTime     @default(now())

  @@index([orderId])
}

model PaymentWebhookLog {
  id        String           @id @default(cuid())
  provider  PaymentProvider
  orderId   String?
  status    String
  error     String?
  payload   Json?
  createdAt DateTime         @default(now())

  @@index([createdAt])
}

enum PaymentProvider {
  PAYME
  CLICK
  MOCK
}

enum PaymentOrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

model Event {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  organizationId    String?
  org               Organization?   @relation(fields: [organizationId], references: [id])
  name              String
  type              EventType
  date              DateTime?
  location          String?
  organization      String?
  language          String          @default("uz")
  participantCount  Int?
  brandingKit       BrandingKit?
  logoUrl           String?
  primaryColor      String          @default("#2563EB")
  accentColor       String          @default("#1E40AF")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  designs       Design[]
  materials     EventMaterial[]
  participants  Participant[]
}

model EventMaterial {
  id         String           @id @default(cuid())
  eventId    String
  event      Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category   MaterialCategory
  status     MaterialStatus   @default(PENDING)
  designId   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([eventId, category])
  @@index([eventId])
}

enum MaterialStatus {
  PENDING
  IN_PROGRESS
  READY
}

enum BrandingKit {
  CLASSIC
  MODERN
  ACADEMIC
  CORPORATE
}

model Template {
  id          String           @id @default(cuid())
  name        String
  nameUz      String?
  nameRu      String?
  category    MaterialCategory
  eventType   EventType?
  isPremium   Boolean          @default(false)
  previewUrl  String
  svgContent  String           @db.Text
  tags        String[]
  createdAt   DateTime         @default(now())
  designs     Design[]
}

model Design {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id])
  templateId  String
  template    Template @relation(fields: [templateId], references: [id])
  name        String
  canvasData  Json
  exportedUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Participant {
  id           String                 @id @default(cuid())
  eventId      String
  event        Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fullName     String
  email        String?
  organization String?
  role         String?
  createdAt    DateTime               @default(now())
  claimToken   ParticipantClaimToken?

  @@index([eventId])
}

model ParticipantClaimToken {
  participantId String      @id
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  token         String      @unique
  expiresAt     DateTime
  emailedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([token])
}

model RateLimitEntry {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

model ExportLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  designId  String?
  eventId   String?
  format    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum EventType {
  CONFERENCE
  SEMINAR
  FORUM
  WORKSHOP
  CORPORATE
  SCIENTIFIC
  EDUCATIONAL
  OTHER
}

enum MaterialCategory {
  CERTIFICATE
  BADGE
  INVITATION
  FLYER
  POSTER
  SCIENTIFIC_POSTER
  PROGRAM_BOOK
  ROLL_UP
  PRESS_WALL
  STAGE_BACKDROP
  LED_SCREEN
  TABLE_TENT
  NAVIGATION
  SOCIAL_MEDIA
  EMAIL_BANNER
  SOUVENIR
  NAME_TAG
  SPONSOR_BANNER
}
