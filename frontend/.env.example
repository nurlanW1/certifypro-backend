# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# Database
DATABASE_URL=postgresql://...

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payments (optional — mock works without)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYMENT_DEV_TOKEN=dev
PAYMENT_WEBHOOK_SECRET=your_webhook_secret

# AI suggestions (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email (Resend — agentlik takliflari + sertifikat)
RESEND_API_KEY=
EMAIL_FROM=Gildia <noreply@gildia.uz>
CERTIFICATE_CLAIM_DAYS=30

# Platform admin (vergul bilan email lar)
GILDIA_ADMIN_EMAILS=admin@gildia.uz

# Cron (Vercel Cron yoki tashqi)
CRON_SECRET=change_me

# Vercel Blob (shablon preview CDN cache)
BLOB_READ_WRITE_TOKEN=

# Monitoring (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Payme checkout base (default https://checkout.paycom.uz)
PAYME_CHECKOUT_URL=
