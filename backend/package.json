{
  "name": "gildia-backend",
  "version": "1.0.0",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "npm run build && node server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node -e \"require('./dist/register').registerGildiaCoreApi(require('express')())\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1056.0",
    "@react-email/components": "^0.0.20",
    "@react-email/render": "^0.0.8",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "bull": "^4.16.5",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "react": "^18.2.0",
    "svg-to-pdfkit": "^0.1.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.10",
    "typescript": "^5.7.2"
  }
}
