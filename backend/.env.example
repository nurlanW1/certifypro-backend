# Railway Variables (Settings → Variables)
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Frontend (Vercel) — CORS uchun
FRONTEND_URL=https://gildia.uz
CORS_ORIGIN=https://gildia.uz
# CORS_ORIGINS=https://gildia.uz,https://www.gildia.uz

# Backend o‘zi
BACKEND_URL=http://localhost:4000

# Redis (Bull queues — ixtiyoriy)
# REDIS_URL=redis://default:password@host:port

# --- Gildia Core API (SQLite + JWT) ---
DATABASE_PATH=./data/gildia.db
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Local file storage (logo, signature, stamp, photos, excel, exports)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000

# Dev only: X-Dev-User-Id header bypasses JWT when NODE_ENV !== production
AUTH_ALLOW_DEV_HEADER=true

# S3 / Cloudflare R2 (production)
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=gildia-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Rate limits (per IP, per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=120
RATE_LIMIT_UPLOAD_MAX=30

# Upload size limits (bytes)
UPLOAD_MAX_BYTES=15728640
EXPORT_MAX_BYTES=52428800

# Payment gateways (Uzbekistan) — backend-only; frontend uses /api/billing/* and /api/payments/click/*
PAYMENT_CALLBACK_BASE_URL=http://localhost:4000

# Click (https://docs.click.uz)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
CLICK_RETURN_URL=http://localhost:3000/pricing?payment=click
# Optional: override pay link base (default https://my.click.uz/services/pay)
# CLICK_PAY_BASE_URL=https://my.click.uz/services/pay
# Legacy/simple webhook header check (SHOP API uses CLICK_SECRET_KEY + sign_string)
# CLICK_WEBHOOK_SECRET=

# Payme (https://developer.help.paycom.uz)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_RETURN_URL=http://localhost:3000/pricing?payment=payme
# PAYME_CHECKOUT_BASE_URL=https://checkout.paycom.uz
# Uzum Bank Merchant API (https://developer.uzumbank.uz)
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=
UZUM_SERVICE_ID=
UZUM_RETURN_URL=http://localhost:3000/pricing?payment=uzum
# Optional HMAC header verification (Basic auth uses UZUM_MERCHANT_ID or UZUM_SERVICE_ID + UZUM_SECRET_KEY)
# UZUM_WEBHOOK_SECRET=
# UZUM_CHECKOUT_BASE_URL=https://checkout.uzum.uz

# Paynet — placeholder until official merchant API docs are available
PAYNET_MERCHANT_ID=
PAYNET_SECRET_KEY=
PAYNET_SERVICE_ID=
PAYNET_RETURN_URL=http://localhost:3000/pricing?payment=paynet
